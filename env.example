# DigitalOcean secrets: none

CREDENTIAL_ID=
DO_ACCESS_KEY=
DO_SECRET_KEY=
DO_SPACE_NAME=
DO_SPACE_REGION=
ES_PASSWORD=
ES_TOTP_SECRET=

#!/bin/sh
set -eu
install -d /opt/blazium/games /opt/blazium/bin /etc/profile.d
if [ ! -f /etc/profile.d/blazium.sh ]; then
  cat > /etc/profile.d/blazium.sh << 'EOF'
# Blazium Hub + CLI environment (installed to /etc/profile.d/blazium.sh)
export BLAZIUM=/opt/blazium
case ":${PATH}:" in
  *":${BLAZIUM}/bin:"*) ;;
  *) export PATH="${BLAZIUM}/bin:${PATH}" ;;
esac
EOF
fi
if [ ! -x /opt/blazium/bin/blazium-cli ] && [ -x /opt/blazium/games/blazium-cli ]; then
  cp -a /opt/blazium/games/blazium-cli /opt/blazium/bin/blazium-cli
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi

; Engine configuration file.
; Games launcher. Host role, player tools only. Edited with the games_module editor.

config_version=5

[application]

config/name="Blazium Games"
config/description="Blazium games launcher."
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/low_processor_mode=true

[autoload]

Session="*res://scripts/session.gd"
Installs="*res://scripts/installs.gd"
Confirm="*res://scripts/confirm.gd"
UriRouter="*res://scripts/uri_router.gd"
SingleInstance="*res://scripts/single_instance.gd"
LauncherRemote="*res://scripts/launcher_remote.gd"
IrcClient="*res://scripts/irc_client.gd"
PlayerMcp="*res://scripts/player_mcp.gd"
Shell="*res://scripts/shell.gd"

[blazium]

role="host"
remote_control/server_enabled=true
remote_control/server_port=39220
remote_control/allow_runtime=true
remote_control/bind_address="127.0.0.1"
justamcp/game_control_enabled=true
justamcp/export_port=39221
justamcp/tools/scene_tools=false
justamcp/tools/script_tools=false
justamcp/tools/project_tools=false
justamcp/tools/node_tools=false
justamcp/tools/resource_tools=false
justamcp/tools/animation_tools=false
justamcp/tools/profiling_tools=false
justamcp/tools/export_tools=false
justamcp/tools/batch_tools=false
justamcp/tools/audio_tools=false
justamcp/tools/blueprint_tools=false
justamcp/tools/input_tools=false
justamcp/tools/particle_tools=false
justamcp/tools/physics_tools=false
justamcp/tools/scene_3d_tools=false
justamcp/tools/shader_tools=false
justamcp/tools/theme_tools=false
justamcp/tools/tilemap_tools=false
justamcp/tools/analysis_tools=false
justamcp/tools/asset_tools=false
justamcp/tools/draw_tools=false
justamcp/tools/environment_tools=false
justamcp/tools/editor_tools=false
justamcp/tools/remote_control_tools=false

[display]

window/size/viewport_width=1100
window/size/viewport_height=720
window/size/min_viewport_width=800
window/size/min_viewport_height=520

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
